{
  "name": "fanbox-downloader",
  "version": "3.5.1",
  "description": "pixiv FANBOXの投稿を投稿毎にフォルダ分け → ZIPとして一括ダウンロードするブックマークレット",
  "scripts": {
    "build": "bun build ./fanbox-downloader.ts --outfile ./docs/fanbox-downloader.min.js --format esm --target browser --minify",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValerianDillon/fanbox-downloader.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ValerianDillon/fanbox-downloader/issues"
  },
  "homepage": "https://ValerianDillon.github.io/fanbox-downloader/",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "download-helper": "github:ValerianDillon/download-helper#v5.1.0"
  }
}
